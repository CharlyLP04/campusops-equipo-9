graph TD
    subgraph ui["UI (Presentación)"]
        A[IncidentListScreen]
        B[IncidentDetailScreen]
    end

    subgraph application["Application (Casos de uso)"]
        C[GetIncidentsUseCase]
        D[GetIncidentDetailUseCase]
    end

    subgraph domain["Domain (Entidades y Puertos)"]
        E[Incident entity]
        F[IncidentRepository port]
    end

    subgraph infrastructure["Infrastructure (Adaptadores)"]
        G[InMemoryIncidentRepository]
        H[CourseBackend API adapter]
    end

    A --> C
    B --> D
    C --> F
    D --> F
    F --> E
    G --> F
    H --> F

    %% Roles de usuario
    subgraph roles["Roles (Actores)"]
        R1[Reportante]
        R2[Técnico]
        R3[Coordinador]
    end

    R1 --> A
    R2 --> B
    R3 --> B

    %% REGLA: La capa UI nunca depende directamente de Infrastructure.
    %% Toda comunicación pasa por Application y el puerto del Domain.
